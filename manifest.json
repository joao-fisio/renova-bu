{
  "manifest_version": 3,
  "name": "BU UFSC - Renova\u00e7\u00e3o Autom\u00e1tica",
  "version": "1.2.1",
  "description": "Renova automaticamente todos os livros emprestados na Biblioteca Universit\u00e1ria da UFSC (Pergamum).",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://pergamum.ufsc.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pergamum.ufsc.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}